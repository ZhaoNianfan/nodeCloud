# ============================================================
# NoteCloud Caddy 配置
# 用法：把下面的 note.example.com 换成你自己的域名（域名需解析到服务器 IP），
# 然后：caddy reload --config /etc/caddy/Caddyfile
# 首次启动会自动申请 Let's Encrypt 免费 HTTPS 证书。
# 前提：阿里云安全组已放行 80 / 443 端口。
# ============================================================

note.example.com {
    reverse_proxy 127.0.0.1:3000
    encode gzip
}

# ------------------------------------------------------------
# 没有域名、只想用 IP 访问时，用下面这段代替（HTTP，无 HTTPS）：
#   http://<你的服务器公网IP> {
#       reverse_proxy 127.0.0.1:3000
#       encode gzip
#   }
# 或者干脆直接用 http://<IP>:3000 访问（记得安全组放行 3000）。
# ------------------------------------------------------------
